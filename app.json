{
  "expo": {
    "name": "cadterreiros-mobile",
    "slug": "cadterreiros-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/cad.logo.png",
    "scheme": "cadterreirosmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permission": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "INTENET"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/cad.color.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/cad.color.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "recordAudioAndroid": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dde2604d-c916-42bc-a4be-2f1ddc96a886"
      }
    },
    "owner": "suporte_cciao"
  }
}
